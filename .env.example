# 로컬 개발용 — .env.local 로 복사하세요 (비밀값은 채팅·Git에 넣지 마세요)

ADMIN_PASSWORD=your-admin-password
ADMIN_SESSION_SECRET=change-me-to-random-string

# Supabase
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_ANON_KEY=eyJ...anon...

# SEO · sitemap/robots/canonical (끝 슬래시 없이)
VITE_SITE_URL=https://wedding-rcxo.vercel.app

OWNER_EMAIL=you@example.com
RESEND_API_KEY=re_...

# 홈(랜딩) 접속 시 OWNER_EMAIL(또는 MC_NOTIFY_EMAIL)로 알림 — Vercel에서는 기본 켜짐
SITE_VISIT_NOTIFY=true
# SITE_VISIT_NOTIFY_EMAIL=you@example.com
# EMAILJS_VISIT_TEMPLATE_ID=template_xxx
